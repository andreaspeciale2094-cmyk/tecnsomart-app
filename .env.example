ANTHROPIC_API_KEY=sk-ant-...
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_USER_NAME=Andrea

# Controllo del PC (shell e file). Lascia false finche' non sai cosa fai.
JARVIS_PC_CONTROL=false
JARVIS_WORKDIR=./workspace

# Domotica (Home Assistant)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Mail (Gmail con password per app) e calendario (indirizzo segreto iCal)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
CALENDAR_ICS_URL=

# Login (consigliato se esponi l'app fuori da localhost)
JARVIS_PASSWORD=

# Voce naturale: TTS con ElevenLabs oppure OpenAI; Whisper e embeddings con OpenAI
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
OPENAI_API_KEY=

# Briefing mattutino automatico (ora locale del server), es. 07:30
BRIEFING_TIME=

# Stile della voce. ElevenLabs: scegli dalla Voice Library una voce maschile calma/britannica e copia l'ID.
# OpenAI: OPENAI_VOICE (onyx, echo, ash...) e VOICE_STYLE (istruzioni di tono, in linguaggio naturale).
OPENAI_VOICE=onyx
VOICE_STYLE=

# Voce gratuita (Edge TTS): attiva da sola se non hai chiavi ElevenLabs/OpenAI.
# Maschili: it-IT-DiegoNeural, it-IT-GiuseppeMultilingualNeural. Femminile: it-IT-ElsaNeural.
EDGE_VOICE=it-IT-GiuseppeMultilingualNeural

# Funzioni extra (spente di default: cosi' non costano nulla). Metti true per attivarle.
JARVIS_WEB_SEARCH=true
JARVIS_AGENTS=false
JARVIS_MAIL=false
JARVIS_HOME=false

# Router (risparmio): domande semplici a Groq. Chiave gratuita su console.groq.com. Senza chiave risponde sempre Claude.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Quanto pensa Claude: low (veloce ed economico), medium, high
JARVIS_EFFORT=low
# Prezzi per milione di token, solo per il costo stimato nel registro (controlla i listini)
PRICE_GROQ_IN=0.59
PRICE_GROQ_OUT=0.79

# Voce: auto (migliore disponibile, ripiego sulla gratuita), edge (SOLO gratuita, nessuna spesa), elevenlabs, openai
JARVIS_VOICE=auto

# Riepilogo dei negozi TecnoSmart (true per attivarlo). La chiave la genera Andrea e la mette anche nell'app Apps Script.
JARVIS_NEGOZI=false
TECNOSMART_TOKEN=
# Focus per addetto (true per attivarlo; serve JARVIS_NEGOZI e la porta "addetti" nell'app)
JARVIS_ADDETTI=false
# Cassa dei contanti a voce (solo registro sul PC)
JARVIS_CASSA=false
# Conto personale in SOLA LETTURA (Enable Banking). La chiave privata va in memoria\banca\chiave.pem, mai nel .env ne' in chat
JARVIS_BANCA=false
ENABLE_BANKING_APP_ID=

# Briefing del mattino e agenda (true per attivarli). Gli indirizzi sono SEGRETI: "Indirizzo segreto in formato iCal" di Google Calendar.
JARVIS_AGENDA=false
CALENDARIO_PERSONALE_ICS=
CALENDARIO_LAVORO_ICS=
